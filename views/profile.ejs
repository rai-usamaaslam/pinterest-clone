<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>User Profile</title>
    <link rel="stylesheet" href="/stylesheets/profile.css">
</head>

<body>
    <%- include("partials/navbar") %>
        <section class="profile-section">
            <div class="profile-card">

                <div class="profile-image-wrapper"> <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRUCe-EjAn_Oc1k8-IAHG6LskeX6EmRWXH7k78vNYvoPzDXXH5lEhcRgN6d&s=10" alt="Profile Picture" class="profile-image">

                    <button class="edit-profile" type="button" onclick="document.getElementById('profileImageInput').click()" title="Change profile picture"> ✎ </button>
                    <input type="file" id="profileImageInput" accept="image/*" hidden> </div>
                <h1 class="profile-name">
                    <%= user.fullname %>
                </h1>
                <p class="profile-username"> @
                    <%= user.username %>
                </p>
                <div class="profile-buttons"> <a href="/upload" class="add-pin"> Add Pin </a> <a href="/logout" class="logout"> Logout </a> </div>
            </div>
        </section>
        <section class="pins-section">
            <% user.posts.forEach(function(post) { %>
                <div class="pin-card"> <img src="/images/uploads/<%= post.image %>" alt="<%= post.imageText %>" class="pin-image">
                    <div class="pin-info">
                        <h3>
                            <%= post.imageText %>
                        </h3>
                        <% if (post.description) { %>
                            <p>
                                <%= post.description %>
                            </p>
                            <% } %>
                    </div>
                </div>
                <% }); %>
        </section>

        <script>
            const profileInput = document.getElementById("profileImageInput");
            const profileImage = document.querySelector(".profile-image");
            profileInput.addEventListener("change", function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        profileImage.src = event.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        </script>
</body>

</html>