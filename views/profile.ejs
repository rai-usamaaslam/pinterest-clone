      <p class="tagline">Keep    .</p>
      <p class="description">Masih belajar CSS dan HTML.</p>
      <a href="/logout" class="button">Logout</a>
      <form action="/upload" method="post" enctype="multipart/form-data">
        <input type="file" name="file">
        <button type="submit">Upload</button>
      </form>
    </div>
</div>
<div class="container">
   <div class="card" style="width: 18rem;">
  <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTRatxHmYyyDHD2MZ0o6kYI4ANvc0k32P5HCK-ZOcr2yg&s=10" class="card-img-top" alt="...">
  <div class="card-body">
    <h5 class="card-title">All Designs</h5>
     
  </div>
</div>
</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>