<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Log in to Pinterest</title>
    <link rel="stylesheet" href="/stylesheets/login.css" />
    <!-- Font Awesome for Social Icons (Optional) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
  </head>
  <body>
    <!-- Top Left Toggle Button -->
    <a href="/users/register" class="upbtn">Sign up</a>

    <!-- Centered Login Card -->
    <main class="container">
      <div class="content">
        <!-- Pinterest Logo -->
        <svg
          class="img1"
          height="40"
          width="40"
          viewBox="0 0 24 24"
          aria-label="Pinterest"
        >
          <path
            fill="#e60023"
            d="M12 0a12 12 0 0 0-4.37 23.17c-.07-.63-.13-1.6.03-2.3.14-.6 1-4.25 1-4.25s-.26-.52-.26-1.3c0-1.22.7-2.13 1.58-2.13.75 0 1.1.56 1.1 1.23 0 .75-.48 1.88-.73 2.92-.2 1 .53 1.8 1.5 1.8 1.8 0 3.16-1.9 3.16-4.64 0-2.42-1.74-4.12-4.23-4.12-2.88 0-4.57 2.16-4.57 4.39 0 .87.33 1.8 1 2.2.1.07.13.14.1.25l-.26 1.08c-.04.17-.15.22-.33.14-1.22-.57-1.98-2.35-1.98-3.78 0-3.08 2.24-5.9 6.45-5.9 3.38 0 6.02 2.41 6.02 5.63 0 3.36-2.12 6.07-5.07 6.07-.99 0-1.92-.51-2.24-1.12l-.6 2.3c-.22.86-.82 1.94-1.23 2.6A12 12 0 1 0 12 0z"
          />
        </svg>

        <h1 class="header">Welcome to Pinterest</h1>

        <!-- Login Form -->
        <form action="/login" method="POST">
          <div class="input-group">
            <input
              type="text"
              name="username"
              class="detail"
              placeholder="Email or Username"
              required
            />
          </div>

          <div class="input-group">
            <input
              type="password"
              name="password"
              class="detail"
              placeholder="Password"
              required
            />
          </div>

          <a href="/forgot-password" class="forgot-link"
            >Forgot your password?</a
          >

          <button type="submit" class="btn int">Log in</button>
        </form>

        <footer>
          <p>
            By continuing, you agree to Pinterest's <b>Terms of Service</b> and
            acknowledge you've read our <b>Privacy Policy</b>.
          </p>
          <hr />
          <p>
            Not on Pinterest yet?
            <a href="/profile" class="signup-link">Sign up</a>
          </p>
        </footer>
      </div>
    </main>
  </body>
</html>
