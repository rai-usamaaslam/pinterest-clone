<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Pinterest Feed</title>

    <link rel="stylesheet" href="/stylesheets/feed.css">
</head>

<body>

    <!-- Navbar -->
    <%- include("partials/navbar") %>


        <!-- Pinterest Feed -->
        <div class="container">

            <% posts.forEach(function(post) { %>

                <div class="content-wrapper">

                    <div class="image-wrapper">

                        <!-- Hover Overlay -->
                        <div class="overlay">

                            <div class="overlay-top">

                                <% if (post.user) { %>

                                    <p>
                                        <%= post.user.username %>
                                    </p>

                                    <% } else { %>

                                        <p>Unknown User</p>

                                        <% } %>

                                            <button class="save">
                Save
              </button>

                            </div>


                            <div class="overlay-bottom">

                                <button class="spheric-button">
                Pinterest
              </button>

                                <button class="round-button">
                <img
                  src="https://cdn-icons-png.flaticon.com/512/3580/3580382.png"
                  alt="Share"
                >
              </button>

                                <button class="round-button">
                <img
                  src="https://cdn-icons-png.flaticon.com/512/512/512142.png"
                  alt="More"
                >
              </button>

                            </div>

                        </div>


                        <!-- Uploaded Image -->
                        <img src="/images/uploads/<%= post.image %>" alt="<%= post.imageText %>">

                    </div>


                    <!-- Pin Title -->
                    <p class="pin-title">
                        <%= post.imageText %>
                    </p>


                    <!-- Description -->
                    <% if (post.description) { %>

                        <p class="pin-description">
                            <%= post.description %>
                        </p>

                        <% } %>

                </div>

                <% }); %>

        </div>

</body>

</html>